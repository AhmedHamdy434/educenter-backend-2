generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionType {
  MONTHLY
  YEARLY
}

model SubscriptionPlan {
  id String @id @default(cuid())

  name        String  @unique
  description String?
  image       String?

  price Decimal @db.Decimal(10, 2)

  type SubscriptionType @default(MONTHLY)

  studentLimit Int
  teacherLimit Int

  canCreateExams Boolean @default(false)

  isPopular Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  centerSubscriptions CenterSubscription[]
}

model Center {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String?

  logo String?

  email   String  @unique
  phone   String
  address String?

  isActive Boolean @default(true)

  subscriptions        CenterSubscription[]
  subscriptionPayments SubscriptionPayment[]

  users User[]

  teachers           Teacher[]
  students           Student[]
  grades             Grade[]
  subjects           Subject[]
  groups             Group[]
  groupStudents      GroupStudent[]
  attendanceSessions AttendanceSession[]
  studentAttendances StudentAttendance[]
  monthlyPayments    MonthlyPayment[]
  extraSessions      ExtraSession[]

  settings              CenterSettings?
  feeObligations        StudentFeeObligation[]
  paymentTransactions   PaymentTransaction[]
  paymentAllocations    PaymentAllocation[]
  teacherEarningEntries TeacherEarningEntry[]
  teacherSettlements    TeacherSettlement[]
  paymentRefunds        PaymentRefund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

model CenterSubscription {
  id String @id @default(cuid())

  centerId String
  center   Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  subscriptionPlanId String
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])

  customPrice Decimal @db.Decimal(10, 2)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  status SubscriptionStatus @default(ACTIVE)

  payments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([centerId])
  @@index([subscriptionPlanId])
}

model SubscriptionPayment {
  id String @id @default(cuid())

  centerSubscriptionId String
  centerSubscription   CenterSubscription @relation(fields: [centerSubscriptionId], references: [id], onDelete: Cascade)

  centerId String
  center   Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  paid Decimal @db.Decimal(10, 2)

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  paymentMethod String?
  notes         String?

  createdAt DateTime @default(now())

  @@index([centerSubscriptionId])
  @@index([centerId])
}

enum UserRole {
  OWNER
  TEACHER
  STUDENT
}

model User {
  id String @id @default(cuid())

  fullName String

  email    String @unique
  password String

  phone  String? @unique
  avatar String?

  role UserRole

  isActive Boolean @default(true)

  mustChangePassword Boolean @default(false)

  centerId String
  center   Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  teacher Teacher?
  student Student?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([centerId])
  @@index([role])
}

model SuperAdmin {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  centerId String
  center   Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  bio String?

  subjects TeacherSubject[]
  groups   Group[]

  obligations    StudentFeeObligation[]
  earningEntries TeacherEarningEntry[]
  settlements    TeacherSettlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([centerId])
}

model Student {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  centerId String
  center   Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  code String @unique

  parentPhone String?

  notes String?

  enrollments         StudentEnrollment[]
  groups              GroupStudent[]
  attendance          StudentAttendance[]
  extraSessions       ExtraSessionStudent[]
  feeObligations      StudentFeeObligation[]
  paymentTransactions PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([centerId])
}

model Grade {
  id String @id @default(cuid())

  name  String
  order Int    @default(0)

  description String?

  isActive Boolean @default(true)

  centerId String
  center   Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  subjects Subject[]

  enrollments StudentEnrollment[]
  groups      Group[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([centerId, name])
  @@index([centerId])
}

model Subject {
  id String @id @default(cuid())

  name String

  description String?

  isActive Boolean @default(true)

  centerId String
  center   Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  teacherSubjects TeacherSubject[]
  groups          Group[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([centerId, gradeId, name])
  @@index([centerId])
}

model TeacherSubject {
  id String @id @default(cuid())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teacherId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
}

model StudentEnrollment {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  enrollmentDate DateTime @default(now())

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([studentId, gradeId])
  @@index([studentId])
  @@index([gradeId])
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model Group {
  id          String   @id @default(cuid())
  name        String
  capacity    Int?
  monthlyFee  Decimal  @default(0.00) @db.Decimal(10, 2)
  startDate   DateTime @default(now())
  monthsCount Int      @default(1)
  isActive    Boolean  @default(true)

  centerId String
  center   Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  schedule           GroupSchedule[]
  students           GroupStudent[]
  attendanceSessions AttendanceSession[]
  extraSessions      ExtraSession[]
  feeObligations     StudentFeeObligation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([centerId, name])
  @@index([centerId])
  @@index([gradeId])
  @@index([subjectId])
  @@index([teacherId])
}

model GroupSchedule {
  id      String    @id @default(cuid())
  groupId String
  group   Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  day     DayOfWeek
  hour    Int
  minute  Int

  @@index([groupId])
}

model GroupStudent {
  id                    String                 @id @default(cuid())
  groupId               String
  group                 Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId             String
  student               Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  centerId              String
  center                Center                 @relation(fields: [centerId], references: [id], onDelete: Cascade)
  joinedAt              DateTime               @default(now())
  subscriptionStartDate DateTime               @default(now())
  payments              MonthlyPayment[]
  feeObligations        StudentFeeObligation[]

  @@unique([groupId, studentId])
  @@index([groupId])
  @@index([studentId])
  @@index([centerId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  ATTENDED_ANOTHER_GROUP
}

model AttendanceSession {
  id String @id @default(cuid())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  centerId String
  center   Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  extraSessionId String?       @unique
  extraSession   ExtraSession? @relation(fields: [extraSessionId], references: [id], onDelete: Cascade)

  date DateTime // Normalized date (UTC midnight)

  records StudentAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([centerId])
}

model StudentAttendance {
  id String @id @default(cuid())

  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  centerId String
  center   Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  status AttendanceStatus

  absenceReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@index([centerId])
}

model MonthlyPayment {
  id               String       @id @default(cuid())
  groupStudentId   String
  groupStudent     GroupStudent @relation(fields: [groupStudentId], references: [id], onDelete: Cascade)
  centerId         String
  center           Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  subscriptionDate DateTime
  amount           Decimal      @db.Decimal(10, 2)
  paidAt           DateTime     @default(now())
  notes            String?
  createdAt        DateTime     @default(now())

  @@unique([groupStudentId, subscriptionDate])
  @@index([groupStudentId])
  @@index([centerId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

enum ExtraSessionType {
  MAKEUP
  REVISION
  EXAM_PREP
  OTHER
}

enum ExtraSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

enum ExtraSessionAudience {
  ALL_GROUP
  SELECTED
}

model ExtraSession {
  id       String @id @default(cuid())
  centerId String
  center   Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  groupId  String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  title    String?
  type     ExtraSessionType     @default(OTHER)
  audience ExtraSessionAudience @default(ALL_GROUP)
  status   ExtraSessionStatus   @default(SCHEDULED)

  date     DateTime @db.Date
  hour     Int
  minute   Int
  location String?

  fee               Decimal   @default(0.00) @db.Decimal(10, 2)
  notes             String?
  cancellationNotes String?
  canceledAt        DateTime?

  participants      ExtraSessionStudent[]
  attendanceSession AttendanceSession?
  feeObligations    StudentFeeObligation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([centerId, date])
  @@index([groupId])
}

model ExtraSessionStudent {
  id             String       @id @default(cuid())
  extraSessionId String
  extraSession   ExtraSession @relation(fields: [extraSessionId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  centerId       String

  amountDue Decimal   @db.Decimal(10, 2)
  isWaived  Boolean   @default(false)
  paid      Decimal?  @db.Decimal(10, 2)
  paidAt    DateTime?
  notes     String?

  @@unique([extraSessionId, studentId])
  @@index([studentId])
  @@index([centerId])
}

enum ObligationType {
  MONTHLY_TUITION
  EXTRA_SESSION
}

enum ObligationStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  INSTAPAY
  VODAFONE_CASH
  BANK_TRANSFER
  OTHER
}

enum TeacherEarningType {
  EARNING
  REFUND_ADJUSTMENT
  SETTLEMENT
  REVERSAL
}

enum SettlementStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model CenterSettings {
  id       String @id @default(cuid())
  centerId String @unique
  center   Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  centerSharePercentage  Decimal @default(20.00) @db.Decimal(5, 2)
  teacherSharePercentage Decimal @default(80.00) @db.Decimal(5, 2)

  allowStudentCreditAdvance Boolean @default(true)
  currency                  String  @default("EGP")
  receiptNotes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([centerId])
}

model StudentFeeObligation {
  id        String  @id @default(cuid())
  centerId  String
  center    Center  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  groupId        String?
  group          Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupStudentId String?
  groupStudent   GroupStudent? @relation(fields: [groupStudentId], references: [id], onDelete: Cascade)
  extraSessionId String?
  extraSession   ExtraSession? @relation(fields: [extraSessionId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  type            ObligationType   @default(MONTHLY_TUITION)
  periodDate      DateTime         @db.Date
  amountDue       Decimal          @db.Decimal(10, 2)
  discountAmount  Decimal          @default(0.00) @db.Decimal(10, 2)
  finalAmountDue  Decimal          @db.Decimal(10, 2)
  paidAmount      Decimal          @default(0.00) @db.Decimal(10, 2)
  remainingAmount Decimal          @db.Decimal(10, 2)
  status          ObligationStatus @default(UNPAID)

  lockedTeacherShareRate Decimal @db.Decimal(5, 2)
  lockedCenterShareRate  Decimal @db.Decimal(5, 2)

  isWaived Boolean @default(false)
  isLegacy Boolean @default(false)
  notes    String?

  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupStudentId, periodDate])
  @@index([centerId, status])
  @@index([studentId])
  @@index([teacherId])
  @@index([periodDate])
}

model PaymentTransaction {
  id        String  @id @default(cuid())
  centerId  String
  center    Center  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  receiptNumber     String
  amount            Decimal @db.Decimal(10, 2)
  allocatedAmount   Decimal @default(0.00) @db.Decimal(10, 2)
  unallocatedAmount Decimal @db.Decimal(10, 2)
  refundedAmount    Decimal @default(0.00) @db.Decimal(10, 2)

  paymentMethod PaymentMethod @default(CASH)
  paymentDate   DateTime      @default(now())
  isLegacy      Boolean       @default(false)
  notes         String?
  createdById   String?

  allocations PaymentAllocation[]
  refunds     PaymentRefund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([centerId, receiptNumber])
  @@index([centerId])
  @@index([studentId])
  @@index([paymentDate])
}

model PaymentAllocation {
  id            String               @id @default(cuid())
  centerId      String
  center        Center               @relation(fields: [centerId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   PaymentTransaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  obligationId  String
  obligation    StudentFeeObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  amount           Decimal @db.Decimal(10, 2)
  teacherShareRate Decimal @db.Decimal(5, 2)
  centerShareRate  Decimal @db.Decimal(5, 2)
  teacherAmount    Decimal @db.Decimal(10, 2)
  centerAmount     Decimal @db.Decimal(10, 2)
  refundedAmount   Decimal @default(0.00) @db.Decimal(10, 2)
  isLegacy         Boolean @default(false)

  earningEntries TeacherEarningEntry[]
  refunds        PaymentRefund[]

  createdAt DateTime @default(now())

  @@index([transactionId])
  @@index([obligationId])
  @@index([centerId])
}

model TeacherEarningEntry {
  id        String  @id @default(cuid())
  centerId  String
  center    Center  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  entryNumber String
  type        TeacherEarningType
  amount      Decimal            @db.Decimal(10, 2)

  sourceAllocationId String?
  sourceAllocation   PaymentAllocation? @relation(fields: [sourceAllocationId], references: [id], onDelete: SetNull)
  sourceRefundId     String?
  sourceRefund       PaymentRefund?     @relation(fields: [sourceRefundId], references: [id], onDelete: SetNull)
  sourceSettlementId String?
  sourceSettlement   TeacherSettlement? @relation(fields: [sourceSettlementId], references: [id], onDelete: SetNull)

  allocatedToSettlementAmount Decimal  @default(0.00) @db.Decimal(10, 2)
  notes                       String?
  entryDate                   DateTime @default(now())
  createdAt                   DateTime @default(now())

  settlementItems SettlementItem[]

  @@unique([centerId, entryNumber])
  @@index([centerId, teacherId])
  @@index([type])
  @@index([entryDate])
}

model TeacherSettlement {
  id        String  @id @default(cuid())
  centerId  String
  center    Center  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  settlementNumber String
  amount           Decimal          @db.Decimal(10, 2)
  status           SettlementStatus @default(COMPLETED)
  paymentMethod    PaymentMethod    @default(CASH)
  referenceNumber  String?
  notes            String?

  settlementDate     DateTime  @default(now())
  settledAt          DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdById        String?

  items          SettlementItem[]
  earningEntries TeacherEarningEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([centerId, settlementNumber])
  @@index([centerId])
  @@index([teacherId])
  @@index([status])
  @@index([settlementDate])
}

model SettlementItem {
  id             String              @id @default(cuid())
  settlementId   String
  settlement     TeacherSettlement   @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  earningEntryId String
  earningEntry   TeacherEarningEntry @relation(fields: [earningEntryId], references: [id], onDelete: Cascade)

  allocatedAmount Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  @@index([settlementId])
  @@index([earningEntryId])
}

model PaymentRefund {
  id            String             @id @default(cuid())
  centerId      String
  center        Center             @relation(fields: [centerId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  allocationId  String?
  allocation    PaymentAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)

  refundNumber       String
  amount             Decimal  @db.Decimal(10, 2)
  teacherRefundShare Decimal  @db.Decimal(10, 2)
  centerRefundShare  Decimal  @db.Decimal(10, 2)
  reason             String
  refundDate         DateTime @default(now())
  createdById        String?

  earningEntries TeacherEarningEntry[]

  createdAt DateTime @default(now())

  @@unique([centerId, refundNumber])
  @@index([centerId])
  @@index([transactionId])
  @@index([allocationId])
  @@index([refundDate])
}
